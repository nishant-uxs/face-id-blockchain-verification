# Google Cloud Vision — OPTIONAL (billing required). Local face + SerpAPI work without it.
GOOGLE_APPLICATION_CREDENTIALS=

# Primary reverse-image provider (Google Lens via SerpAPI) — recommended
SERPAPI_KEY=

# Pinata IPFS
PINATA_JWT=
PINATA_GATEWAY=gateway.pinata.cloud

# Ethereum Sepolia
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
CONTRACT_ADDRESS=

# Pipeline options
MAX_IMAGE_BYTES=10485760
FACE_SELECTION=largest
REQUIRE_SOCIAL_MATCH=true
