# Google Cloud Vision (Web Detection) — service account JSON path
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json

# Optional secondary reverse-image provider (SerpAPI Google Lens)
SERPAPI_KEY=

# Pinata IPFS
PINATA_JWT=
PINATA_GATEWAY=gateway.pinata.cloud

# Base Sepolia
RPC_URL=https://sepolia.base.org
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
CONTRACT_ADDRESS=

# Pipeline options
MAX_IMAGE_BYTES=10485760
FACE_SELECTION=largest
REQUIRE_SOCIAL_MATCH=true
