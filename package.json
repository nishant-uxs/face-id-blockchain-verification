{
  "name": "face-id-blockchain-verification",
  "version": "1.0.0",
  "description": "HH Goa 2026 Task #3 — Face ID + Blockchain Verification (CLI pipeline)",
  "repository": {
    "type": "git",
    "url": "https://github.com/nishant-uxs/face-id-blockchain-verification.git"
  },
  "homepage": "https://github.com/nishant-uxs/face-id-blockchain-verification#readme",
  "bugs": {
    "url": "https://github.com/nishant-uxs/face-id-blockchain-verification/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20 <=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "verify": "tsx src/cli/index.ts verify",
    "audit": "tsx src/cli/index.ts audit",
    "deploy": "tsx scripts/deploy.ts",
    "self-test": "tsx scripts/self-test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:failure": "tsx scripts/failure-tests.ts",
    "check": "npm test && npm run self-test && npm run typecheck",
    "compare-providers": "tsx scripts/compare-providers.ts",
    "prepare-demo": "tsx scripts/prepare-demo.ts"
  },
  "keywords": [
    "hacker-house-goa",
    "face-id",
    "face-detection",
    "reverse-image-search",
    "blockchain",
    "ethereum-sepolia",
    "ipfs",
    "serpapi"
  ],
  "license": "MIT",
  "dependencies": {
    "@google-cloud/vision": "^4.3.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "npm:@tensorflow/tfjs@^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "boxen": "^8.0.1",
    "canvas": "^3.1.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "pinata": "^2.1.0",
    "sharp": "^0.33.5",
    "viem": "^2.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "solc": "^0.8.28",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
